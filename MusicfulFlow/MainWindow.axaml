<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MusicfulFlow.MainWindow"
        Title="Musicful Flow" Width="1000" Height="860" MinWidth="1000" MinHeight="860" Background="#F4F7FB">
  <Window.Styles>
    <Style Selector="Border.panel"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="24"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#65758B"/></Style>
    <Style Selector="Button.nav"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#BED5EB"/><Setter Property="Padding" Value="13,10"/><Setter Property="CornerRadius" Value="7"/></Style>
    <Style Selector="Button.nav:pointerover"><Setter Property="Background" Value="#203B5C"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#1976D2"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="17,10"/></Style>
  </Window.Styles>
  <Grid ColumnDefinitions="244,*">
    <Border Background="#102A43" Padding="25">
      <StackPanel Spacing="20">
        <StackPanel Spacing="6">
          <TextBlock Text="Musicful Flow" FontSize="24" FontWeight="Bold" Foreground="White"/>
          <TextBlock Text="自動簽到控制台" Foreground="#A9CCE8"/>
          <TextBlock Text="管理登入狀態、GitHub Actions 與每日簽到結果。" TextWrapping="Wrap" FontSize="12" Foreground="#8FB9DB" Margin="0,8,0,0"/>
        </StackPanel>
        <Border Background="#193958" CornerRadius="10" Padding="14">
          <StackPanel Spacing="6"><TextBlock Text="安全提醒" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="登入、OTP 與 CAPTCHA 必須由你在瀏覽器中完成。此工具只會匯出登入狀態。" TextWrapping="Wrap" FontSize="12" Foreground="#BED5EB"/></StackPanel>
        </Border>
        <StackPanel Spacing="5">
          <Button Classes="nav" Click="DashboardNavButton_OnClick">簽到總覽</Button>
          <Button Classes="nav" Click="AccountsNavButton_OnClick">帳號設定</Button>
          <Button Classes="nav" Click="LoginNavButton_OnClick">更新登入狀態</Button>
        </StackPanel>
        <TextBlock Text="排程：台灣時間 05、13、21 點；每次隨機延遲 0–59 分鐘" TextWrapping="Wrap" FontSize="12" Foreground="#8FB9DB" Margin="0,18,0,0"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Column="1" Margin="38,34,24,24" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="650" Spacing="18">
        <StackPanel x:Name="DashboardView" Spacing="18">
          <TextBlock Text="簽到總覽" FontSize="30" FontWeight="SemiBold" Foreground="#132A42"/>
          <TextBlock Classes="muted" Text="手動執行每日簽到，並讀取最近一次 Musicful Auto Sign 的完成狀態。" TextWrapping="Wrap"/>
          <Border Classes="panel"><StackPanel Spacing="18">
            <TextBlock Text="GitHub Actions 儀表板" FontSize="20" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="TriggerButton" Classes="primary" Click="TriggerButton_OnClick">立即執行簽到</Button><Button x:Name="RefreshButton" Click="RefreshButton_OnClick">更新執行結果</Button></StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
              <StackPanel Spacing="4"><TextBlock Classes="muted" Text="已設定帳號" FontSize="12"/><TextBlock x:Name="ConfiguredMetric" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="#0F766E"/></StackPanel>
              <StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="muted" Text="最近執行" FontSize="12"/><TextBlock x:Name="RunMetric" Text="尚未讀取" FontSize="20" FontWeight="SemiBold"/></StackPanel>
            </Grid>
            <Border Height="1" Background="#DCE5EF"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
              <StackPanel Spacing="4"><TextBlock Classes="muted" Text="已紀錄連續簽到" FontSize="12"/><TextBlock x:Name="MonthlyStreakMetric" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="#0F766E"/></StackPanel>
              <StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="muted" Text="完成時間" FontSize="12"/><TextBlock x:Name="RunTimeMetric" Text="—" FontSize="18" FontWeight="SemiBold"/></StackPanel>
            </Grid>
            <TextBlock x:Name="DashboardStatus" Classes="muted" Text="執行後可在 GitHub Actions 檢視各帳號的成功、失敗與連續簽到天數。" TextWrapping="Wrap"/>
            <TextBlock Text="各帳號連續簽到天數" FontSize="16" FontWeight="SemiBold"/>
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MonthlyAccountsPanel" Spacing="7"/></ScrollViewer>
          </StackPanel></Border>
        </StackPanel>
        <StackPanel x:Name="AccountsView" IsVisible="False" Spacing="18">
          <TextBlock Text="帳號設定" FontSize="30" FontWeight="SemiBold" Foreground="#132A42"/>
          <TextBlock Classes="muted" Text="名稱只保存在本機，用於讓 33 個 GitHub Secret 更容易辨識。" TextWrapping="Wrap"/>
          <Border Classes="panel"><StackPanel Spacing="12"><TextBlock Text="帳號別名" FontSize="19" FontWeight="SemiBold"/><ScrollViewer MaxHeight="410"><StackPanel x:Name="AliasPanel" Spacing="8"/></ScrollViewer><Button HorizontalAlignment="Left" Click="SaveAliasesButton_OnClick">儲存本機別名</Button></StackPanel></Border>
        </StackPanel>
        <StackPanel x:Name="LoginView" IsVisible="False" Spacing="18">
          <TextBlock Text="更新登入狀態" FontSize="30" FontWeight="SemiBold" Foreground="#132A42"/>
          <TextBlock Classes="muted" Text="瀏覽器開啟後完成登入並停留在 Musicful 成長中心；工具偵測到登入狀態後會自動匯出 Storage State。" TextWrapping="Wrap"/>
          <Border Classes="panel"><StackPanel Spacing="14">
            <TextBlock Text="選擇帳號" FontSize="19" FontWeight="SemiBold"/>
            <ComboBox x:Name="AccountComboBox" Width="210" SelectedIndex="0" SelectionChanged="AccountComboBox_OnSelectionChanged"/>
            <TextBlock Text="瀏覽器" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <ComboBox x:Name="BrowserComboBox" Width="320" SelectedIndex="0"/>
            <TextBlock Classes="muted" Text="預設使用 Chrome／Chromium；若無法登入可改選 Edge 或 Firefox 備案。請用同一瀏覽器完成匯出與後續驗證。" TextWrapping="Wrap" FontSize="12"/>
            <Border Background="#E8F1FB" CornerRadius="7" Padding="12,8"><TextBlock x:Name="SecretNameText" FontFamily="Consolas" Foreground="#125799"/></Border>
            <Button x:Name="StartLoginButton" Classes="primary" HorizontalAlignment="Left" Click="StartLoginButton_OnClick">開始登入並匯出</Button>
            <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="CopyStateButton" IsEnabled="False" Click="CopyStateButton_OnClick">複製 Base64</Button><Button x:Name="UpdateSecretButton" IsEnabled="False" Click="UpdateSecretButton_OnClick">更新 GitHub Secret</Button><Button x:Name="CopySecretButton" Click="CopySecretButton_OnClick">複製 Secret 名稱</Button></StackPanel>
            <Border Height="1" Background="#DCE5EF" Margin="0,4"/>
            <TextBlock Text="目前帳號積分" FontSize="16" FontWeight="SemiBold"/>
            <Button x:Name="ReadPointsButton" HorizontalAlignment="Left" Click="ReadPointsButton_OnClick">讀取目前帳號積分</Button>
            <TextBlock x:Name="PointsStatus" Classes="muted" Text="需要先匯出此帳號的登入狀態。" TextWrapping="Wrap"/>
            <TextBlock x:Name="LoginStatus" Classes="muted" Text="匯出後，點選「更新 GitHub Secret」上傳目前帳號的登入 token；請先使用 gh auth login 登入。" TextWrapping="Wrap"/>
          </StackPanel></Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
